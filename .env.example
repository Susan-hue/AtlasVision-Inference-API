# Copy to .env and adjust. Every variable is optional unless marked REQUIRED.
# docker-compose sets REDIS_URL itself, so you only need it when running outside Compose.

# --- Shared (API and worker) -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Seconds an uploaded image is kept while its job waits/runs. Jobs still queued after
# this are dropped, so keep it comfortably above (queue depth x average job time).
IMAGE_TTL=900
# Seconds a finished job's status/result can be polled.
RESULT_TTL=3600
# Seconds a session lives after its last use (refreshed on every use).
SESSION_TTL=86400

# Seconds a single job may run before it is failed. Size this for the slowest case: a
# non-English question is 3 generations (translate question, answer, translate back).
JOB_TIMEOUT=300
# Turns of conversation history kept per session; older turns are dropped.
MAX_SESSION_TURNS=8

# Worker heartbeat period, and how old a heartbeat may get before the API reports the
# worker as unavailable and stops accepting jobs. STALE_AFTER must exceed INTERVAL.
HEARTBEAT_INTERVAL=10
HEARTBEAT_STALE_AFTER=30

# Log user questions and model answers. Off by default: user content may be personal.
LOG_CONTENT=false
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- API only ---------------------------------------------------------------------------
# Comma-separated client API keys, sent in the X-API-Key header. Use long random values,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
API_KEYS=
# Comma-separated browser origins allowed by CORS. Empty (the default) disables CORS: the
# API is called server to server (e.g. from a Vercel route), never directly from browsers.
CORS_ORIGINS=

# Largest accepted image upload, in megabytes. 4 fits under Vercel's 4.5 MB body limit.
MAX_IMAGE_MB=4
# Ceiling on max_new_tokens per request (non-English chat uses 2x this to translate back).
MAX_NEW_TOKENS=256
# Longest accepted chat question, in characters.
MAX_QUESTION_CHARS=1000

# Queued jobs allowed before new submissions get 503 with Retry-After.
MAX_QUEUE_DEPTH=100
# Requests per minute per API key: job submissions, and job polling (counted separately,
# since clients poll every couple of seconds while a job runs).
RATE_LIMIT=60
RATE_LIMIT_POLL=1200

# --- Worker only ------------------------------------------------------------------------
# REQUIRED unless USE_FAKE_MODEL=true. Hugging Face token with read access to the gated
# NCAIR1/N-ATLaS model. Never set this on the API.
HF_TOKEN=
# AtlasVision checkpoint: 2b (recommended), 2, or 1 (captioner only).
ATLAS_STAGE=2b
# true/false; leave unset to let the SDK decide (4-bit on GPUs under 20 GB).
# LOAD_IN_4BIT=
# Use the canned FakeAtlasVision instead of the real model (no GPU needed).
USE_FAKE_MODEL=true
