# Copy to .env and adjust. Read by the API and the worker. Every variable is optional
# unless marked REQUIRED. Worker-only settings (HF_TOKEN, model, fake model) go in
# .env.worker instead; see .env.worker.example. Compose sets REDIS_URL itself, so you only
# need it when running outside Compose.

# --- Shared (API and worker) -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Seconds an uploaded image is kept while its job waits/runs. Jobs still queued after
# this are dropped, so keep it comfortably above (queue depth x average job time).
IMAGE_TTL=900
# Seconds a finished job's status/result can be polled.
RESULT_TTL=3600
# Seconds a session lives after its last use (refreshed on every use).
SESSION_TTL=86400

# Seconds a single job may run before it is failed. Size this for the slowest case: a
# non-English question is 3 generations (translate question, answer, translate back).
JOB_TIMEOUT=300
# Turns of conversation history kept per session; older turns are dropped.
MAX_SESSION_TURNS=8

# Worker heartbeat period, and how old a heartbeat may get before the API reports the
# worker as unavailable and stops accepting jobs. STALE_AFTER must exceed INTERVAL.
HEARTBEAT_INTERVAL=10
HEARTBEAT_STALE_AFTER=30

# Log user questions and model answers. Off by default: user content may be personal.
LOG_CONTENT=false
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- API only ---------------------------------------------------------------------------
# REQUIRED. Comma-separated client API keys, sent in the X-API-Key header. The API refuses
# to start without one. Use long random values, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Comma-separated browser origins allowed by CORS. Empty (the default) disables CORS: the
# API is called server to server (e.g. from a Vercel route), never directly from browsers.
CORS_ORIGINS=

# Largest accepted image upload, in megabytes. 4 fits under Vercel's 4.5 MB body limit.
MAX_IMAGE_MB=4
# Ceiling on max_new_tokens per request (non-English chat uses 2x this to translate back).
MAX_NEW_TOKENS=256
# Longest accepted chat question, in characters.
MAX_QUESTION_CHARS=1000

# Queued or running jobs allowed before new submissions get 503 with Retry-After.
MAX_QUEUE_DEPTH=100

# Retry-After seconds sent with 503 model_unavailable, 503 queue_full, and 503
# service_unavailable (Redis unreachable).
RETRY_AFTER_MODEL_UNAVAILABLE=30
RETRY_AFTER_QUEUE_FULL=30
RETRY_AFTER_SERVICE_UNAVAILABLE=5

# Requests per minute. "Client" is the X-Client-Id visitor (or the key itself when no
# X-Client-Id is sent); "key" is the total across all clients using one API key.
# Submit = POST /v1/jobs/chat (GPU work). Read = every other endpoint, including polling
# (a client polling every 2 s uses 30 per minute per job).
RATE_LIMIT_SUBMIT_PER_CLIENT=10
RATE_LIMIT_SUBMIT_PER_KEY=120
RATE_LIMIT_READ_PER_CLIENT=120
RATE_LIMIT_READ_PER_KEY=3000
