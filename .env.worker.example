# Copy to .env.worker for the worker only. The API never reads this file, so the
# Hugging Face token never reaches the API. The worker also reads .env for shared settings.
# Compose forces USE_FAKE_MODEL=true for its local worker.

# REQUIRED unless USE_FAKE_MODEL=true. Hugging Face token with read access to the gated
# NCAIR1/N-ATLaS model. Never set this on the API.
HF_TOKEN=
# AtlasVision checkpoint: 2b (recommended), 2, or 1 (captioner only).
ATLAS_STAGE=2b
# true/false; leave unset to let the SDK decide (4-bit on GPUs under 20 GB).
# LOAD_IN_4BIT=
# Use the canned FakeAtlasVision instead of the real model (no GPU needed). Set to false
# on the GPU machine.
USE_FAKE_MODEL=true
# Fake model only: simulated load time, and time per simulated generation (a chat job is
# 1 to 3 generations).
FAKE_LOAD_SECONDS=2
FAKE_GENERATION_SECONDS=0.5
# Fake model only: fail at startup with this SDK error to test the "failed" worker state.
# One of AuthenticationError, GatedModelAccessError, ModelLoadError.
# FAKE_LOAD_ERROR=
# Fake model only: put __raise_<ErrorName>__ in a question to make that job raise, e.g.
# __raise_ImageLoadError__, __raise_UnsupportedLanguageError__, __raise_RuntimeError__.
